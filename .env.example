# Only one engine in RAM. Restart: pm2 restart tts --update-env
# Match LOCAL_TTS_* in /data/kivo_calling_pbx/.env

ACTIVE_TTS_MODEL=goonj
ACTIVE_TTS_VOICE=en_priya
ACTIVE_TTS_LANGUAGE=a
GOONJ_MODEL_DIR=/data/goonj/models/goonj-1-82M

# Optional: stock Kokoro instead
# ACTIVE_TTS_MODEL=kokoro
# ACTIVE_TTS_VOICE=af_heart
# ACTIVE_TTS_LANGUAGE=a

TTS_HOST=127.0.0.1
TTS_PORT=8765
