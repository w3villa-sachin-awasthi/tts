# Only one engine in RAM. Restart: pm2 restart tts --update-env
# Match LOCAL_TTS_* in /data/kivo_calling_pbx/.env

ACTIVE_TTS_MODEL=pocket
ACTIVE_TTS_VOICE=alba
ACTIVE_TTS_LANGUAGE=en

# Optional Hindi (needs a consent WAV path as ACTIVE_TTS_VOICE):
# POCKET_CONFIG=hf://saryps-labs/pocket-tts-hindi/config.yaml
# ACTIVE_TTS_VOICE=/data/tts/voices/ref_hi.wav

TTS_HOST=127.0.0.1
TTS_PORT=8765
