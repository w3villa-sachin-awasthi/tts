# Model / voice / language are HARDCODED in active_tts.py (edit MODEL_NAME there).
# This file is only for paths + server bind.

# Mithi (active by default in active_tts.py) — reuse voice-assistant-test download:
MITHI_MODEL_DIR=/data/voice-assistant-test/models/mithi-v2-flash
# MITHI_DEVICE=auto

# Goonj (when you switch active_tts.py back to goonj):
# GOONJ_MODEL_DIR=/data/goonj/models/goonj-1-82M

# Legacy commented ACTIVE_TTS_* (ignored — use active_tts.py instead):
# ACTIVE_TTS_MODEL=mithi
# ACTIVE_TTS_VOICE=ahana
# ACTIVE_TTS_LANGUAGE=en

# Server bind only (optional):
TTS_HOST=127.0.0.1
TTS_PORT=8765
